# Drone Telemetry Hub — Environment Configuration
# Copy this file to .env and adjust values.

# HTTP server port
PORT=8080

# SQLite database file path
DB_PATH=/data/telemetry.db

# Connection string for the drone (MAVSDK format)
# UDP client:  udp://:14540
# UDP server:  udp://0.0.0.0:14540
# Serial:      serial:///dev/ttyUSB0:57600
# TCP client:  tcp://127.0.0.1:5760
DRONE_CONNECTION_URL=udp://:14540

# Polling interval in milliseconds (how often to read telemetry)
POLL_INTERVAL_MS=1000

# Enable mock mode (no real drone required)
MOCK_MODE=true

# Log level: trace, debug, info, warn, error, critical
LOG_LEVEL=info
